<ResourceDictionary
    x:Class="DaleGhent.NINA.AstroPhysicsTools.ApMeridianLimitTrigger.ApMeridianLimitTriggerTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DaleGhent.NINA.AstroPhysicsTools.ApMeridianLimitTrigger"
    xmlns:util="clr-namespace:DaleGhent.NINA.AstroPhysicsTools.Utility"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <DataTemplate DataType="{x:Type local:ApMeridianLimitTrigger}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical" Margin="5,0,10,0">
                        <TextBlock VerticalAlignment="Center" Text="Flip Strategy" />
                        <ComboBox
                            VerticalAlignment="Center"
                            Margin="0,2,0,2"
                            MinWidth="100"
                            ItemsSource="{Binding Source={util:EnumBindingSource {x:Type local:ApFlipStrategy}}}"
                            SelectedItem="{Binding FlipStrategy}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Text="|" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFlipTime}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLimitTime}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding LimitTimeLabel}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding LimitTimeDisplay}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding TimeUntilLimitDisplay}" />
                                <TextBlock VerticalAlignment="Center" Text="remaining" Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Text="|" Margin="10,0,10,0" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFlipTime}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding FlipTimeLabel}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding FlipTimeDisplay}" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding TimeUntilFlipDisplay}" />
                            <TextBlock VerticalAlignment="Center" Text="remaining" Margin="5,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlipping}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock VerticalAlignment="Center" Text="|" Margin="10,0,10,0" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ActiveStage}" />
                    </StackPanel>
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="DaleGhent.NINA.AstroPhysicsTools.ApMeridianLimitTrigger_Mini">
        <mini:MiniSequenceItem>
        </mini:MiniSequenceItem>
    </DataTemplate>
</ResourceDictionary>